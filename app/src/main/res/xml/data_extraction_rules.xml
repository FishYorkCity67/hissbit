<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Cloud-Sicherung und Umzug auf ein neues Gerät. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="file" path="python_files/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="file" path="python_files/" />
    </device-transfer>
</data-extraction-rules>
